{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "document_id",
    "requirements"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "phrase",
          "concept",
          "status",
          "explicit",
          "evidence",
          "section",
          "qualifier",
          "experience_years",
          "alternatives",
          "negated",
          "statement_scope",
          "match_basis",
          "task",
          "tools",
          "review_reason"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "phrase": {
            "type": "string"
          },
          "concept": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "required",
              "preferred",
              "not_required",
              "unclear"
            ]
          },
          "explicit": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "qualifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "experience_years": {
            "type": [
              "number",
              "null"
            ]
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "negated": {
            "type": "boolean"
          },
          "statement_scope": {
            "enum": [
              "qualification",
              "responsibility",
              "company_expectation",
              "company_description",
              "hiring_process",
              "unknown"
            ]
          },
          "match_basis": {
            "enum": [
              "exact_phrase",
              "interpreted",
              "unresolved"
            ]
          },
          "task": {
            "type": [
              "string",
              "null"
            ]
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
